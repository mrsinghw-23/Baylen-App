{
  "functions": {
    "targets": [
      "baylen-api"
    ],
    "ignore": [],
    "source": "functions",
    "scripts": {
      "predeploy": "node ../scripts/ensure-whatsapp-otp-env.js --sync",
      "postdeploy": "node ../scripts/ensure-whatsapp-otp-env.js --verify-live"
    }
  },
  "client": {
    "source": "client"
  },
  "apig": {
    "enabled": true,
    "rules": "catalyst-user-rules.json"
  },
  "appsail": [
    {
      "source": "appsail\\baylen-auth",
      "name": "baylen-auth"
    }
  ]
}
