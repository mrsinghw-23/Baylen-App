# Baylen Catalyst Function Environment
# Do not commit real values. Add these in Zoho Catalyst Console -> Settings -> Environments / Function environment variables.

# Required for secure customer session token signing.
# Production: must be at least 32 characters — baylen-api fails startup if missing when BAYLEN_ENV=production.
AUTH_SESSION_SECRET=replace-with-long-random-secret

# Required for /v1/admin/* routes.
# Production: must be at least 32 characters.
ADMIN_API_KEY=replace-with-long-random-admin-key

# Production runtime marker (Development: leave unset or use development).
# BAYLEN_ENV=production

# Nationwide professional dispatch (default: true).
# Set false to require legacy salon Provider_Services bridge for home-service matching.
# BAYLEN_ALL_INDIA_DISPATCH=true

# Product-delivery pincode gate: strict | state | national (default: national when all-India is on).
# DISPATCH_PINCODE_GATE_MODE=national

# Inventory import worker: inline (dev default) or deferred (production default).
# Deferred jobs require Cron POST /v1/admin/inventory/import/worker/process.
# INVENTORY_IMPORT_WORKER_MODE=deferred

# Required for Play Store login OTP on WhatsApp (baylen-api function env vars).
# The Flutter app calls baylen-api /v1/auth/otp/* — NOT AppSail baylen-auth.
# Before deploy: node scripts/ensure-whatsapp-otp-env.js --sync
TATA_WHATSAPP_API_KEY=
TATA_WHATSAPP_SENDER=
TATA_TEMPLATE_NAME=baylen_app_auth
# Dedicated Utility template for salon booking confirmation WhatsApp.
# New OTP users require an approved template; OTP login does not open a free-text window.
TATA_BOOKING_TEMPLATE_NAME=baylen_booking_confirmed

# Shared template for order + booking confirmations (optional — needs Meta approval).
# Body must be a single variable: {{1}}
# Leave blank when using the dedicated booking/order templates below.
# Set WHATSAPP_PLAIN_TEXT_ONLY=true to skip template attempts entirely.
# See backend/docs/WHATSAPP_NOTIFY_TEMPLATE.md
TATA_NOTIFY_TEMPLATE_NAME=
WHATSAPP_PLAIN_TEXT_ONLY=

# Dedicated Utility template for shop order confirmation WhatsApp.
# Plain text is only best-effort inside an existing 24-hour WhatsApp conversation.
TATA_ORDER_TEMPLATE_NAME=baylen_order_confirmed

# Catalyst File Store folder for Delivery Partner KYC documents (private; never public URLs).
FILESTORE_KYC_FOLDER_ID=36851000000390615

# Optional shared media folder fallback when KYC folder is unset.
# FILESTORE_MEDIA_FOLDER_ID=
# /v1/jobs/dispatch, /v1/jobs/accept, /v1/jobs/status, /v1/jobs/location
PROVIDER_API_KEY=replace-with-long-random-provider-key

# Quick Commerce picker ops (/v1/picker/*)
PICKER_API_KEY=replace-with-long-random-picker-key

# Quick Commerce rider ops (/v1/rider/*)
RIDER_API_KEY=replace-with-long-random-rider-key

# Hybrid fulfillment defaults (optional)
FULFILLMENT_QC_RADIUS_KM=3
FULFILLMENT_QC_ETA_MIN=15
FULFILLMENT_QC_ETA_MAX=20
FULFILLMENT_EC_ETA_DAYS_MIN=2
FULFILLMENT_EC_ETA_DAYS_MAX=3
FULFILLMENT_QC_COD_LIMIT=2000

# Optional payment gateway configuration.
# If both Razorpay values are set, /v1/payments/providers will report razorpay.enabled=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree is retained for compatibility but disabled until its full flow is implemented.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Future push/mail provider values can be added here after Catalyst Push Notifications
# and mobile platform credentials are configured.
# Zoho Commerce product sync for Shop.
# Required scope: ZohoCommerce.items.READ
ZOHO_COMMERCE_ENABLED=false
ZOHO_COMMERCE_CONNECTION_LINK_NAME=zoho_commerce_connection
ZOHO_COMMERCE_ORGANIZATION_ID=
ZOHO_COMMERCE_CLIENT_ID=
ZOHO_COMMERCE_CLIENT_SECRET=
ZOHO_COMMERCE_REFRESH_TOKEN=
ZOHO_COMMERCE_AUTH_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_COMMERCE_REFRESH_URL=https://accounts.zoho.com/oauth/v2/token
ZOHO_COMMERCE_API_BASE=https://commerce.zoho.com
ZOHO_COMMERCE_STOREFRONT_DOMAIN=www.baylende.com
ZOHO_COMMERCE_MAX_PAGES=5

# Encrypted Data Store backups (see backend/docs/hybrid-commerce/BACKUP_RECOVERY.md)
# BACKUP_ENCRYPTION_KEY=<64-char hex or base64-encoded 32-byte key>
# WORKDRIVE_CONNECTION_NAME=zohodrive
# BACKUP_WORKDRIVE_DAILY_FOLDER_ID=
# BACKUP_WORKDRIVE_WEEKLY_FOLDER_ID=
# BACKUP_WORKDRIVE_MONTHLY_FOLDER_ID=
# BACKUP_WORKDRIVE_RECOVERY_FOLDER_ID=
